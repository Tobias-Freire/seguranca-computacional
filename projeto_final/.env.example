# Copie para .env e ajuste se necessário: cp .env.example .env

# Versão fixa da imagem do honeypot (confirmar a tag na Parte 2)
COWRIE_TAG=latest

# Contramedida fail2ban (hardened-ssh)
F2B_MAXRETRY=5
F2B_FINDTIME=60
F2B_BANTIME=300

# Painel: intervalo de atualização automática, em segundos
DASHBOARD_REFRESH=5
